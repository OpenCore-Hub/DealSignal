# Host publish ports for docker-compose (container ports stay 5432/6379/9000/80/8080).
# Override when the defaults collide with other stacks on the machine.
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6381
MINIO_HOST_PORT=9003
ONLYOFFICE_HOST_PORT=8085
API_HOST_PORT=8080

PORT=8080
APP_ENV=development
POSTGRES_USER=dealsignal
POSTGRES_PASSWORD=dealsignal
POSTGRES_DB=dealsignal
# Compose-network URLs (internal ports). For host-side `go run`:
#   DATABASE_URL=postgres://dealsignal:dealsignal@127.0.0.1:${POSTGRES_HOST_PORT}/dealsignal?sslmode=disable
#   REDIS_URL=127.0.0.1:${REDIS_HOST_PORT}
DATABASE_URL=postgres://dealsignal:dealsignal@postgres:5432/dealsignal?sslmode=disable
REDIS_URL=redis:6379
JWT_SECRET=change-me-in-production
LINK_SESSION_SECRET=change-me-in-production
# HMAC key for hashing visitor IP addresses. Should be different from JWT_SECRET.
# Generate with: openssl rand -hex 32
IP_HASH_KEY=change-me-in-production
# HMAC key for hashing link invitation tokens. Should be different from JWT_SECRET.
# Generate with: openssl rand -hex 32
INVITE_TOKEN_HASH_KEY=change-me-in-production
LOG_LEVEL=info
VERSION=v2.5.0

# MinIO / S3-compatible object storage (S3_* also seeds MinIO root credentials in compose)
S3_ENDPOINT=http://minio:9000
# Keep in sync with MINIO_HOST_PORT above.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9003
S3_BUCKET=dealsignal
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# OnlyOffice Document Server
ONLYOFFICE_URL=http://onlyoffice:80
ONLYOFFICE_JWT_SECRET=change-me-in-production

# OpenAI-compatible LLM (optional; leave empty to disable LLM suggestion enrichment).
OPENAI_API_KEY=
# For DeepSeek / self-hosted / Azure OpenAI-compatible endpoints, include the /v1 suffix when needed.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional headers for OpenRouter-compatible providers.
# Keep in sync with API_HOST_PORT above.
OPENAI_REFERER=http://127.0.0.1:8080
OPENAI_APP_TITLE=DealSignal
# Domain / SSL (noop = simulated, selfsigned = in-memory dev cert)
BASE_DOMAIN=dealsignal.com
CNAME_TARGET=cname.dealsignal.com
CERT_PROVIDER=noop

# Public URLs used in email links and redirects (APP_BASE_URL host port = API_HOST_PORT)
APP_BASE_URL=http://127.0.0.1:8080
FRONTEND_URL=http://localhost:5173
# Optional: public viewer base URL for share links. Defaults to FRONTEND_URL.
VIEWER_BASE_URL=

# HubSpot OAuth credentials (optional; leave empty to disable HubSpot integration)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# SMTP configuration for transactional emails (optional; leave empty to log to stdout)
# For production, use a trusted SMTP relay on port 587/465 with valid TLS certificates.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dealsignal.com
# Set to true to skip TLS certificate verification. ONLY for local development or test sandboxes.
# In production this must be false or the server will refuse to start.
SMTP_INSECURE_SKIP_VERIFY=false
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_RETRIES=3
SMTP_POOL_MAX_CONNS=10
SMTP_POOL_IDLE_TIMEOUT_SECONDS=60
SMTP_POOL_MAX_LIFETIME_SECONDS=300
SMTP_POOL_MAX_USES=100

# Resend configuration (optional; takes precedence over SMTP if set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@dealsignal.com
RESEND_TIMEOUT_SECONDS=10
RESEND_MAX_RETRIES=3
# Optional: verify Resend webhook signatures (format whsec_...)
RESEND_WEBHOOK_SECRET=

# Branding / localization
DEFAULT_BRAND_NAME=DealSignal
VERIFICATION_TOKEN_TTL_HOURS=24

# Async email queue (Redis Streams). Set to true for production-grade delivery.
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_STREAM=mail:queue
EMAIL_WORKER_COUNT=2
EMAIL_WORKER_INTERVAL_MS=1000
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_BATCH_SIZE=100
EMAIL_WORKER_BATCH_SIZE=10
# Optional: secret for signing email open/click tracking tokens. Leave empty to disable tracking.
EMAIL_TRACKING_SECRET=change-me-in-production
EMAIL_TRACKING_TTL_HOURS=168
EMAIL_RETRY_BACKOFF_BASE_SECONDS=5
EMAIL_RETRY_BACKOFF_MAX_SECONDS=3600

# CORS (comma-separated origins; supports exact match and *.dealsignal.com wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limits (requests per minute)
RATE_LIMIT_PUBLIC_RPM=100
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_UPLOAD_RPM=10
RATE_LIMIT_WORKSPACE_RPM=200

# Idempotency cache (hours and max cached response body bytes)
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_MAX_BODY_SIZE=1048576

# Event deduplication windows (minutes). Redis is used when available and enabled.
LINK_OPEN_DEDUP_WINDOW_MINUTES=30
PAGE_VIEW_DEDUP_WINDOW_MINUTES=5
DEDUP_REDIS_ENABLED=true

# HMAC secret for signing page image and download proxy URLs.
# Must be different from JWT_SECRET and LINK_SESSION_SECRET.
# Generate with: openssl rand -hex 32
URL_SIGNING_SECRET=change-me-in-production

# Optional path to a custom signal generation rules YAML file.
# Leave empty to use the embedded default rules.
SIGNAL_RULES_PATH=

# Background worker that pre-aggregates link features for signal generation.
FEATURE_WORKER_ENABLED=true
FEATURE_WORKER_INTERVAL_MINUTES=5

# How often to refresh the link_heat_scores materialized view (seconds).
# Lower values keep scores fresher but increase DB load.
HEAT_SCORE_REFRESH_INTERVAL_SECONDS=120

# Redis Streams event bus for suggestion -> signal sync.
# Falls back to polling when disabled or Redis is unavailable.
EVENTS_ENABLED=true
EVENTS_STREAM_NAME=events:signal
EVENTS_CONSUMER_GROUP=signal-sync

# Security anomaly detection thresholds
SECURITY_ANOMALY_WINDOW_MINUTES=5
SECURITY_ANOMALY_THRESHOLD=5

# Event retention (days). Events older than these thresholds are cleaned up daily.
ACCESS_LOGS_RETENTION_DAYS=90
PAGE_VIEWS_RETENTION_DAYS=90
SECURITY_EVENTS_RETENTION_DAYS=180

# Observability
METRICS_ENABLED=true
PPROF_ENABLED=false

# Table ingest (xlsx/csv → table_row chunks). Empty TABLE_INGEST_ENABLED → on in non-production; off in production.
# TABLE_INGEST_ENABLED=true
# TABLE_MAX_SHEETS=20
# TABLE_MAX_ROWS_PER_SHEET=5000
# TABLE_MAX_ROWS_PER_FILE=20000

# External docling-rag knowledge base (Platform v2). Leave BASE_URL empty to disable.
# From host-side `go run`: http://127.0.0.1:<rag-port>
# From docker-compose API container: use host.docker.internal (not 127.0.0.1).
# Avoid ONLYOFFICE_HOST_PORT (default 8085) collisions when publishing both stacks.
# Tenant API keys are sealed at rest with URL_SIGNING_SECRET (AES-GCM).
# On provision, API raises trial entitlements (trial max_kbs=1 includes auto "default" KB
# and would otherwise block per-room KB create with code MAX_KBS).
# DOCLING_RAG_BASE_URL=http://host.docker.internal:8088
# DOCLING_RAG_PLATFORM_ADMIN_KEY=
# DOCLING_RAG_HTTP_TIMEOUT_MS=180000
# DOCLING_RAG_DEFAULT_MODE=hybrid
# DOCLING_RAG_TOP_K=8
