# DealSignal web app environment variables

# Optional: real backend origin for `pnpm dev`.
# Empty → MSW mocks.
# Set (e.g. http://127.0.0.1:8090) → the SPA still calls same-origin `/api`;
# Vite proxies that path to this origin so session cookies stay first-party
# (same model as production nginx). Do not fetch the API origin from the
# browser; cross-site POSTs drop SameSite=Lax cookies and 401.
VITE_API_BASE_URL=
