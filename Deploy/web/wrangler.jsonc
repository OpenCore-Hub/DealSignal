{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dealsignal-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-19",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api", "/api/*"]
	},
	"services": [
		{
			"binding": "API",
			"service": "dealsignal-api"
		}
	]
}
